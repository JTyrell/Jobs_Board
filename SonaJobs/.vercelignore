# Vercel ignore file - excludes files from deployment

# Development files
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
.venv/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database files
db.sqlite3
*.sqlite3

# Media files (use external storage in production)
media/

# Test files
tests/
*_test.py
test_*.py
*_tests.py

# Documentation
*.md
docs/
md-docs/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Build artifacts
build/
dist/
*.egg-info/

# Git
.git/
.gitignore

# Node modules (if any)
node_modules/

# Temporary files
tmp/
temp/
